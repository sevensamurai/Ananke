<?xml version="1.0" encoding="utf-8"?>
<!-- Ananke packages come only from the folder scripts/ci.sh packs into; everything else from
     nuget.org. Without the mapping a missing package would be taken from nuget.org's release. -->
<configuration>
  <packageSources>
    <clear />
    <add key="ananke-packed" value="../../artifacts/ci/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="ananke-packed">
      <package pattern="Ananke" />
      <package pattern="Ananke.*" />
      <package pattern="nnke" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
