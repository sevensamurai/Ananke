/// <summary>
/// Immutable state record threaded through the {{name}} workflow.
/// Add fields as needed for your pipeline data.
/// </summary>
public sealed record PipelineState
{
    /// <summary>Raw input data collected by fetch jobs.</summary>
    public IReadOnlyList<string> RawData { get; init; } = [];

    /// <summary>Processed/transformed results.</summary>
    public IReadOnlyDictionary<string, string> Results { get; init; } =
        new Dictionary<string, string>();

    /// <summary>Final summary produced by the last job.</summary>
    public string? Summary { get; init; }
}
