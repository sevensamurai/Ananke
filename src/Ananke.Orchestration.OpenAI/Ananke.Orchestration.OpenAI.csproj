<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Ananke.Orchestration.OpenAI</PackageId>
    <Description>OpenAI provider for Ananke.Orchestration — ChatClient-based IStreamingAgentModel implementation with tool calling and structured output support.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenAI" />
  </ItemGroup>

  <!-- The credential overloads carry an [Experimental] id and message, defined once in
       Ananke.Orchestration. -->
  <ItemGroup>
    <Compile Include="..\Ananke.Orchestration\ExperimentalApis.cs" Link="ExperimentalApis.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ananke.Abstractions\Ananke.Abstractions.csproj" />
  </ItemGroup>

</Project>
