<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>nnke</AssemblyName>
    <RootNamespace>Ananke.Tool</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nnke</ToolCommandName>
    <PackageId>nnke</PackageId>
    <Description>CLI tool for Ananke — scaffold workflow projects, validate manifests, export diagrams, browse documentation, and serve as an MCP server for AI agents.</Description>
    <PackageTags>ananke;cli;dotnet-tool;workflow;agents;scaffold;mcp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ananke.Design\Ananke.Design.csproj" />
    <ProjectReference Include="..\Ananke.Orchestration\Ananke.Orchestration.csproj" />
    <ProjectReference Include="..\Ananke.Organics\Ananke.Organics.csproj" />
    <ProjectReference Include="..\Ananke.Tool.Shared\Ananke.Tool.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Template files contain {{placeholder}} tokens, not compilable C#.
         Files use .ext.template extension to avoid SDK auto-compile globs.
         *.cs.template files need WithCulture="false": MSBuild interprets ".cs" as a
         culture code, strips it from the manifest resource name, and routes the files
         into a satellite assembly, breaking GetManifestResourceStream on the main assembly. -->
    <Compile Remove="Templates\Resources\**" />
    <EmbeddedResource Include="Templates\Resources\*.cs.template" WithCulture="false" />
    <EmbeddedResource Include="Templates\Resources\*.csproj.template" />
    <EmbeddedResource Include="Templates\Resources\*.yml.template" />
    <EmbeddedResource Include="Templates\Resources\*.md.template" />
    <EmbeddedResource Include="Templates\Resources\*.json.template" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Output\" />
  </ItemGroup>

  <!-- nnke docs reads documentation from the filesystem at runtime (see DocsProvider).
       The docs/ directory is located by walking up from CWD to find Ananke.slnx.
       Only guides/ and reference/ are indexed — about/ and learning.md are editorial. -->

  <!--
    Generates obj/TemplateEngine.Versions.g.cs from the two version properties in
    Directory.Build.props so TemplateEngine.cs never drifts from the source of truth.
  -->
  <Target Name="GenerateTemplateEngineVersions" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <_VersionsFile>$(IntermediateOutputPath)TemplateEngine.Versions.g.cs</_VersionsFile>
      <_VersionsContent>// &lt;auto-generated/&gt;
namespace Ananke.Tool.Templates%3B

internal static partial class TemplateEngine
{
    /// &lt;summary&gt;
    /// Ananke package version baked in at build time from Directory.Build.props &lt;c&gt;VersionPrefix&lt;/c&gt;.
    /// &lt;/summary&gt;
    public const string AnankeVersion = "$(VersionPrefix)"%3B

    /// &lt;summary&gt;
    /// Microsoft.Extensions.* package version baked in at build time from Directory.Build.props &lt;c&gt;MsExtensionsVersion&lt;/c&gt;.
    /// &lt;/summary&gt;
    public const string MsExtensionsVersion = "$(MsExtensionsVersion)"%3B
}
</_VersionsContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(_VersionsFile)" Lines="$(_VersionsContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_VersionsFile)" />
    </ItemGroup>
  </Target>

</Project>
