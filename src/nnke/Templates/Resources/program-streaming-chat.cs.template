using Ananke.Abstractions.Agents;
using Ananke.Orchestration.Workflows;
using Ananke.Orchestration.Streaming;
using Microsoft.Extensions.Configuration;

// --- 1. Configuration ---
var config = new ConfigurationBuilder()
    .SetBasePath(AppContext.BaseDirectory)
    .AddJsonFile("secrets.json", optional: true)
    .Build();

// --- 2. Model ---
// var model = new OpenAIAgentModel(config["OpenAI:ApiKey"]!, "gpt-4.1-mini");

// --- 3. Workflow ---
var workflow = new Workflow<ChatState>("{{name}}")
    .Job("respond", async (state, ct) =>
    {
        Console.WriteLine("  Agent: (streaming response will appear here)");
        // var reply = await model.CompleteAsync(state.Messages, ct);
        return state with { LastResponse = "Hello from {{name}}!" };
    })
    .Then("respond", Workflow.End);

// --- 4. Stream events ---
Console.WriteLine("  {{name}} streaming chat ready. Type a message and press Enter.");
Console.Write("  You: ");
var userInput = Console.ReadLine() ?? "";

var initialState = new ChatState { UserInput = userInput };

await foreach (var evt in workflow.StreamAsync(initialState))
{
    if (evt is WorkflowCompleted<ChatState> completed)
        Console.WriteLine($"  Agent: {completed.Result.FinalState.LastResponse}");
}
