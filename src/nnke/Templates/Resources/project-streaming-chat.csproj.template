<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="Exists('secrets.json')">
    <None Update="secrets.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ananke.Orchestration" Version="{{ananke_version}}" />
    <PackageReference Include="{{provider_package}}" Version="{{ananke_version}}" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="{{ms_extensions_version}}" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="{{ms_extensions_version}}" />
  </ItemGroup>

</Project>
