<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>nnke-platform-google</AssemblyName>
    <RootNamespace>Ananke.Tool.Platform.Google</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nnke-platform-google</ToolCommandName>
    <PackageId>nnke-platform-google</PackageId>
    <Description>Google Vertex AI / Gemini Agent Platform adapter for nnke-platform. Install alongside nnke-platform to enable 'deploy --platform vertex-ai'.</Description>
    <PackageTags>ananke;cli;dotnet-tool;federation;google;vertex-ai;gemini;agents</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="nnke-platform-adapters.Tests" />
    <InternalsVisibleTo Include="nnke-platform-all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ananke.Federation.Google\Ananke.Federation.Google.csproj" />
  </ItemGroup>

</Project>
