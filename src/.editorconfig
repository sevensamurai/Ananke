# EditorConfig — enforced by Visual Studio, Roslyn, and dotnet format
# https://editorconfig.org
# Indentation + analyzer configuration. Encoding/EOL policy lives in the repo-root .editorconfig.

[*]
indent_style             = space
insert_final_newline     = true
trim_trailing_whitespace = true

# C# source
[*.cs]
indent_size = 4

# XML-based project/config files
[*.{csproj,props,targets,slnx,config,nuspec,resx,xml}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# Markdown — preserve trailing spaces (they mean <br>)
[*.md]
trim_trailing_whitespace = false

# Shell / PowerShell scripts — keep LF so they work cross-platform
[*.{sh,bash}]
end_of_line = lf

[*.ps1]
end_of_line = crlf

# ── ANANKE_ASYNC_001 legacy suppression ──────────────────────────────────────
# Files below pre-date the ConfigureAwait(false) rule.  New files in any project
# are expected to comply.  Remove entries here as each file is migrated.
# Demo and CLI tool projects — application entrypoints, suppress globally.
[demos/**/*.cs]
dotnet_diagnostic.ANANKE_ASYNC_001.severity = none

[nnke/**/*.cs]
dotnet_diagnostic.ANANKE_ASYNC_001.severity = none

[nnke-platform/**/*.cs]
dotnet_diagnostic.ANANKE_ASYNC_001.severity = none

[nnke-platform-google/**/*.cs]
dotnet_diagnostic.ANANKE_ASYNC_001.severity = none

[nnke-platform-azure/**/*.cs]
dotnet_diagnostic.ANANKE_ASYNC_001.severity = none

[nnke-platform-anthropic/**/*.cs]
dotnet_diagnostic.ANANKE_ASYNC_001.severity = none

[nnke-platform-all/**/*.cs]
dotnet_diagnostic.ANANKE_ASYNC_001.severity = none

