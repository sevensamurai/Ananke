# Demo, CLI tool, and test projects — ambient-clock reads there are either an application
# entrypoint concern (demos/CLI) or legitimate fixed-offset fixture construction (tests), not
# the ambient-clock-in-a-reusable-component problem this rule targets. Suppress globally.
[demos/**/*.cs]
dotnet_diagnostic.ANANKE_TIME_001.severity = none

[nnke/**/*.cs]
dotnet_diagnostic.ANANKE_TIME_001.severity = none

[nnke-platform/**/*.cs]
dotnet_diagnostic.ANANKE_TIME_001.severity = none

[nnke-platform-google/**/*.cs]
dotnet_diagnostic.ANANKE_TIME_001.severity = none

[nnke-platform-azure/**/*.cs]
dotnet_diagnostic.ANANKE_TIME_001.severity = none

[nnke-platform-anthropic/**/*.cs]
dotnet_diagnostic.ANANKE_TIME_001.severity = none

[nnke-platform-all/**/*.cs]
dotnet_diagnostic.ANANKE_TIME_001.severity = none

[tests/**/*.cs]
dotnet_diagnostic.ANANKE_TIME_001.severity = none

# ── ANNKE001/ANNKE002 in tests ────────────────────────────────────────────────
# Test fixtures deliberately reference deprecated model ids and constants: mapper TestCases
# exercise deprecated→current translation, catalog tests assert the Deprecated validation
# path, and the analyzer's own tests need flagged literals as input. That is categorically
# different from production code drifting onto a deprecated model, which these rules exist
# to catch (and which TreatWarningsAsErrors now fails the build on).
dotnet_diagnostic.ANNKE001.severity = none
dotnet_diagnostic.ANNKE002.severity = none
