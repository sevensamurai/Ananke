<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Ananke.Graph.Memgraph</PackageId>
    <Description>Memgraph persistent graph backend for Ananke — IKnowledgeGraph implementation using the Neo4j Bolt driver, with optional MAGE algorithm overrides for PageRank and community detection.</Description>
    <PackageTags>graph;knowledge-graph;memgraph;bolt;dotnet;ai;agents</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Neo4j.Driver" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ananke.Abstractions\Ananke.Abstractions.csproj" />
    <ProjectReference Include="..\Ananke.Graph.Abstractions\Ananke.Graph.Abstractions.csproj" />
  </ItemGroup>

</Project>
