<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Same packaging rationale as Ananke.Analyzers.csproj — this DLL is loaded as an analyzer
         asset (CodeFixProviders live in the same analyzers/dotnet/cs slot as DiagnosticAnalyzers),
         not referenced as an ordinary library. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>

  <!-- Separate from Ananke.Analyzers.csproj because RS1038 forbids a DiagnosticAnalyzer assembly
       from referencing Microsoft.CodeAnalysis.Workspaces (unavailable during command-line/CI
       compilation) — but CodeFixProviders need Workspaces types (CodeAction, Document, etc.). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ananke.Analyzers\Ananke.Analyzers.csproj" />
  </ItemGroup>

</Project>
