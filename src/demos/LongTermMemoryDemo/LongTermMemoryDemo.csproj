<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Update="refactoring.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="secrets.json" Condition="Exists('secrets.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Ananke.Orchestration\Ananke.Orchestration.csproj" />
    <ProjectReference Include="..\..\Ananke.Learning\Ananke.Learning.csproj" />
    <ProjectReference Include="..\..\Ananke.Orchestration.OpenAI\Ananke.Orchestration.OpenAI.csproj" />
    <ProjectReference Include="..\..\Ananke.Documents\Ananke.Documents.csproj" />
    <ProjectReference Include="..\..\Ananke.Qdrant\Ananke.Qdrant.csproj" />
  </ItemGroup>

</Project>
