    <ProjectReference Include="..\..\..\Ananke.Skills\Ananke.Skills.csproj" />
    <ProjectReference Include="..\..\..\Ananke.Organics\Ananke.Organics.csproj" />
    <ProjectReference Include="..\..\..\Ananke.Abstractions\Ananke.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Ananke.Learning\Ananke.Learning.csproj" />
    <ProjectReference Include="..\..\..\Ananke.Qdrant\Ananke.Qdrant.csproj" />
  </ItemGroup>

</Project>
