# Mirrors .editorconfig — one matrix, two enforcers.
* text=auto eol=lf

# C# / .NET source
*.cs        text eol=lf
*.csx       text eol=lf
*.fs        text eol=lf
*.fsx       text eol=lf
*.vb        text eol=lf

# Project / solution files (VS requires CRLF on checkout)
*.csproj    text eol=crlf
*.fsproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.sln       text eol=crlf
*.slnx      text eol=crlf

# Config / data
*.json      text eol=lf
*.xml       text eol=lf
*.config    text eol=lf
*.nuspec    text eol=lf
*.resx      text eol=lf

# Docs
*.md        text eol=lf
*.txt       text eol=lf

# CI / scripting
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.bash      text eol=lf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf
*.psm1      text eol=crlf

# Binary assets — never mangle
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.pdf       binary
*.zip       binary
*.nupkg     binary
*.snupkg    binary
*.dll       binary
*.exe       binary
*.pdb       binary
